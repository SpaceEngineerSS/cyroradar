{
  "name": "cyroradar",
  "version": "2.0.0",
  "description": "Mars subsurface radar in the browser: SHARAD archive data, simulated MARSIS and SHARAD scenes, depth conversion and basal reflection analysis.",
  "type": "module",
  "license": "MIT",
  "author": "Mehmet Gümüş (https://github.com/SpaceEngineerSS)",
  "homepage": "https://cyroradar.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/SpaceEngineerSS/cyroradar.git"
  },
  "bugs": {
    "url": "https://github.com/SpaceEngineerSS/cyroradar/issues"
  },
  "keywords": [
    "mars",
    "radar",
    "planetary-science",
    "sharad",
    "marsis",
    "simulation",
    "subsurface",
    "ice-detection",
    "radargram",
    "scientific-computing"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "jspdf": "^4.2.1",
    "katex": "^0.16.47",
    "motion": "^14.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "three": "^0.183.2",
    "wouter": "^3.13.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "@webgpu/types": "^0.1.74",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "playwright": "^1.64.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.19"
  }
}
